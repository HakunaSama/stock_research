# Copy to `.env` (same dir as docker-compose.yml) and fill in.
# `.env` is gitignored — NEVER commit real keys.
#   cp deploy.env.example .env

# --- HTTP port on the host (aliyun 轻量服务器需在安全组放行此端口) ---
HTTP_PORT=80

# --- 在线深度研究:大模型凭据(可选) -------------------------------
# 不填 => 网站正常运行,但"发起深度研究"按钮置灰(只读展示已有研究)。
# 填了 => 登录用户可主动发起真实 ODR 研究(消耗 token,受每日配额限制)。
# 任何 OpenAI 兼容端点都可(火山方舟/OpenAI/DeepSeek/通义/Moonshot),换 3 个值即可。
STOCK_LLM_BASE_URL=
STOCK_LLM_API_KEY=
STOCK_LLM_MODEL=
STOCK_LLM_TIMEOUT=300
STOCK_LLM_JSON_MODE=auto

# --- 会话与配额 ------------------------------------------------------
SESSION_TTL_SECONDS=604800   # 会话有效期,默认 7 天
COOKIE_SECURE=0              # HTTP 部署保持 0;将来上 HTTPS 后改为 1
RESEARCH_WORKERS=1          # 后台研究并发数(轻量服务器建议 1)
RESEARCH_DAILY_QUOTA=5      # 每用户每日免费研究次数(用完后从点数余额扣)

# --- 邮箱验证码(注册 / 找回密码 / 绑定邮箱) -------------------------
# 三项都填上才会真实发信;留空 = 开发模式,验证码打进日志并随接口回显
# (dev_code),方便本地联调。上线前务必配好 SMTP!
# QQ 邮箱示例: smtp.qq.com:465,SMTP_PASS 填"授权码"而非登录密码。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                  # 发件人地址,留空默认用 SMTP_USER
SMTP_SSL=1                  # 1 = 465 隐式 SSL;0 = 587 STARTTLS

# --- 计费 / 点数系统 -------------------------------------------------
# 深度研究采用"每日免费额度 + 点数预付"模式:先用当天免费次数,
# 用完后每次研究扣 RESEARCH_CREDIT_COST 点;余额不足则拒绝(HTTP 402)。
RESEARCH_CREDIT_COST=1      # 单次深度研究消耗的点数
SIGNUP_BONUS_CREDITS=0      # 新用户注册赠送点数(0 = 不送)
SUB_DAILY_QUOTA=20          # 会员(订阅生效中)每日免费研究次数
# 支付渠道:stub = 占位渠道(下单即模拟支付成功,仅用于本地/演示)。
# 接入真实渠道(如虎皮椒 xunhupay / 支付宝当面付)后改为对应名称,
# 并在 webapp/billing.py 的 _PROVIDERS 注册实现类 + 补充其密钥 env。
PAYMENT_PROVIDER=stub

# ============================================================
# Provider cheat-sheet(选一个填到上面)
# ============================================================
# 火山方舟 / Volcengine Ark
#   STOCK_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   STOCK_LLM_MODEL=ep-xxxxxxxxxxxx   (推理接入点 ID)
# OpenAI
#   STOCK_LLM_BASE_URL=https://api.openai.com/v1
#   STOCK_LLM_MODEL=gpt-4o-mini
# DeepSeek
#   STOCK_LLM_BASE_URL=https://api.deepseek.com/v1
#   STOCK_LLM_MODEL=deepseek-chat
